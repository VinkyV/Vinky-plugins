//onInventoryChange
mc.listen("onInventoryChange", function (pl, slotNum, oldItem, newItem) {
  try {
    let pos = pl.pos;
    if (newItem.isNull())
      writeLog(`${pl.realName}(${pl.xuid}) ${pos.x.toFixed(0)} ${pos.y.toFixed(0)} ${pos.z.toFixed(0)} removed items: ${oldItem.name} ${oldItem.count}x from slot: ${slotNum}`)
    else
      writeLog(`${pl.realName}(${pl.xuid}) ${pos.x.toFixed(0)} ${pos.y.toFixed(0)} ${pos.z.toFixed(0)} put items: ${newItem.name} ${newItem.count}x in slot: ${slotNum}`)
  }
  catch (exception) {
    if(_SHOW_ERROR_INFO) throw exception;
  }
});
//onContainerChange
mc.listen("onContainerChange", function (pl, bl, slotNum, oldItem, newItem) {
  try {
    let pos = pl.pos;
    let blPos = bl.pos;
    if (newItem.isNull())
      writeLog(`${pl.realName}(${pl.xuid}) ${pos.dim} ${pos.x.toFixed(0)} ${pos.y.toFixed(0)} ${pos.z.toFixed(0)} removed items: ${oldItem.name} ${oldItem.count}x from contaner: ${bl.name} ${blPos.x.toFixed(0)} ${blPos.y.toFixed(0)} ${blPos.z.toFixed(0)} from slot: ${slotNum}`)
    else
      writeLog(`${pl.realName}(${pl.xuid}) ${pos.dim} ${pos.x.toFixed(0)} ${pos.y.toFixed(0)} ${pos.z.toFixed(0)} put items: ${newItem.name} ${newItem.count}x in container: ${bl.name} ${blPos.x.toFixed(0)} ${blPos.y.toFixed(0)} ${blPos.z.toFixed(0)} in slot: ${slotNum}`)
  }
  catch (exception) {
    if(_SHOW_ERROR_INFO) throw exception;
  }
});